<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Recordatorios.ViewModels"
             xmlns:models="clr-namespace:Recordatorios.Models"
             x:Class="Recordatorios.Views.RecordatoriosPage"
             x:DataType="vm:RecordatoriosViewModel"
             Title="Recordatorios">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Nuevo" Command="{Binding IrANuevoCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="10">
        <ActivityIndicator Grid.Row="0" IsRunning="{Binding EstaCargando}" IsVisible="{Binding EstaCargando}" />

        <RefreshView Grid.Row="1" Command="{Binding CargarRecordatoriosCommand}" IsRefreshing="{Binding EstaCargando}">
            <CollectionView ItemsSource="{Binding Recordatorios}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Recordatorio">
                        <Grid Padding="10" ColumnDefinitions="*,Auto,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Descripcion}" FontSize="13" TextColor="Gray" />
                                <Label Text="{Binding FechaRecordatorio, StringFormat='Fecha: {0:dd/MM/yyyy}'}" FontSize="12" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1" Text="Editar" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecordatoriosViewModel}}, Path=IrADetalleCommand}" CommandParameter="{Binding .}" />
                            <Button Grid.Column="2" Text="Eliminar" Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RecordatoriosViewModel}}, Path=EliminarCommand}" CommandParameter="{Binding .}" BackgroundColor="DarkRed" TextColor="White" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>